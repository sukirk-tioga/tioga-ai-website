# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git

ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# Gmail SMTP — existing outbound mail (contact-form notifications, audit
# log, migration-assessment copies, and now the autonomous email agent's
# replies). See lib/email.ts.
SMTP_USER=
SMTP_PASS=

# Upstash Redis — conversation state for the autonomous email agent
# (lib/thread-store.ts). REST API, so only a URL + token, no connection
# pooling needed from serverless functions.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# HTTP Basic Auth credentials for Postmark's Inbound Parse webhook
# (app/api/agent/inbound/route.ts). Set these, then register the webhook
# URL in Postmark's dashboard as
# https://<user>:<pass>@agent.tioga.ai/api/agent/inbound — see the PR
# description for the full Postmark setup checklist.
POSTMARK_INBOUND_BASIC_AUTH_USER=
POSTMARK_INBOUND_BASIC_AUTH_PASS=

# Kill switch for the email agent's autonomous sends (app/api/agent/approve/
# route.ts). Every drafted reply (first reply from app/api/classify, and
# every follow-up from app/api/agent/inbound) is held for founder approval
# via lib/agent-approval.ts regardless of this flag — but even an approved
# reply will NOT actually send unless this is explicitly set to the literal
# string "true". Defaults to disabled (unset/anything else = off), matching
# this codebase's fail-closed pattern for unconfigured secrets. Only turn
# this on deliberately once the approval-hold flow itself has been verified.
AGENT_EMAIL_AUTOSEND_ENABLED=false
